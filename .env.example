# GroSplit — copy to `.env` for LAPTOP use and fill it in. `.env` is gitignored.
#
#   cp .env.example .env
#
# Two bots (see SPEC.md §10):
#   laptop     → a TEST bot (its own token here, its own test group, ./test.db)
#   production → the REAL bot, set on Fly with `fly secrets set`, never in this file
# Quickest start with no Telegram at all: `npm run demo` (fake household).

# Test bot token from @BotFather (/newbot). Also the key that verifies Mini App sign-ins.
TELEGRAM_BOT_TOKEN=

# OpenAI API key for reading receipt photos (one vision call per receipt).
OPENAI_API_KEY=

# Leave blank on the laptop. On Fly it defaults to https://<app>.fly.dev.
PUBLIC_URL=

# Leave blank: derived from the bot token so it survives restarts.
WEBHOOK_SECRET=

# The laptop's own database — never the production one.
DATABASE_PATH=./test.db

PORT=3000
